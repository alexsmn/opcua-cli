{
  "version": 8,
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "vcpkg default",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/vcpkg-make",
      "environment": {
        "PKG_CONFIG": "${sourceDir}/../vcpkg/packages/pkgconf_arm64-osx/tools/pkgconf/pkgconf",
        "PATH": "${sourceDir}/../vcpkg/packages/pkgconf_arm64-osx/tools/pkgconf:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-windows",
      "displayName": "vcpkg Windows x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vcpkg-windows",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg",
      "configurePreset": "vcpkg"
    },
    {
      "name": "vcpkg-windows",
      "configurePreset": "vcpkg-windows",
      "configuration": "Debug"
    }
  ]
}
